# Server Port
PORT=3001

# MongoDB Connection URL
DB_URL=mongodb://127.0.0.1:27017/devcollab

# JWT Authentication Secret Key
JWT_SECRET=your_super_secret_jwt_key_here

# Google Gemini API Key (Required for AI Agent & Code Intelligence)
GEMINI_API_KEY=your_google_gemini_api_key

# GitHub OAuth App Credentials (Optional - for GitHub Login & Repo Sync)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_TOKEN=your_optional_github_personal_access_token

# CORS & Client Origins
FRONTEND_URL=http://localhost:4002
CLIENT_URL=http://localhost:4002
ALLOWED_ORIGINS=http://localhost:4002,http://localhost:5173
